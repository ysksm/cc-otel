# cc-otel configuration (all optional; sane local defaults are used)

# HTTP listen address for API + OTLP receiver + web UI
CCOTEL_ADDR=:8080

# DuckDB database file (use :memory: for ephemeral)
CCOTEL_DB_PATH=./data/ccotel.duckdb

# Optional: fixed dev API token created on first boot (else one is generated and
# written to ./data/dev-api-key.txt)
# CCOTEL_DEV_API_KEY=ccotel_local_dev

# Optional: path to a libduckdb you provide instead of auto-downloading it
# DUCKDB_LIBRARY_PATH=/usr/local/lib/libduckdb.so

# --- Optional dashboard auth (off by default) ---
# Enable login by setting an admin password (bootstraps an admin account).
# CCOTEL_ADMIN_EMAIL=admin@local
# CCOTEL_ADMIN_PASSWORD=change-me
# Or enable auth without bootstrapping an admin here:
# CCOTEL_AUTH_ENABLED=true
# Persist sessions across restarts (else a random per-process secret is used):
# CCOTEL_SESSION_SECRET=some-long-random-string

# --- Optional LLM judge for evaluations ---
# CCOTEL_LLM_PROVIDER=openai           # openai-compatible (default) or anthropic
# CCOTEL_LLM_BASE_URL=http://localhost:11434/v1   # e.g. local Ollama
# CCOTEL_LLM_API_KEY=
# CCOTEL_LLM_MODEL=llama3.1

# --- Optional semantic search embeddings (off by default) ---
# CCOTEL_EMBED_PROVIDER=openai          # OpenAI-compatible /embeddings
# CCOTEL_EMBED_BASE_URL=http://localhost:11434/v1   # e.g. local Ollama
# CCOTEL_EMBED_API_KEY=
# CCOTEL_EMBED_MODEL=nomic-embed-text

# --- Optional data retention (off by default) ---
# Delete telemetry older than this many days (sweeps at startup and daily):
# CCOTEL_RETENTION_DAYS=30
